# BYD Horizon Club Environment Configuration
# Copy this file to .env and replace with your actual values

# Application Settings
PORT=3000
APP_URL=http://localhost:3000
NODE_ENV=production
FRONTEND_URL=https://your-domain.com

# Database (PostgreSQL)
DATABASE_URL=postgresql://username:password@localhost:5432/byd_horizon

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-2026-change-in-production

# Gmail SMTP for Emails
GMAIL_USER=your-gmail@gmail.com
GMAIL_PASS=your-gized-app-specific-password-here

# Admin Authentication
ADMIN_EMAIL=admin@bydhorizon.com
ADMIN_OVERRIDE_KEY=Jadai123

# Payment Providers (Live Keys)
PAYSTACK_SECRET_KEY=sk_live_xxxxxx
STRIPE_SECRET_KEY=sk_live_xxxxxx
PAYPAL_CLIENT_ID=xxxxx

# BYD Internal Settings
BYD_API_KEY=your-byd-api-key-here
BYD_WEBHOOK_SECRET=your-wh-secret

# Security
CORS_ORIGINS=https://your-domain.com
RATE_LIMIT_MINUTES=15
MAX_REQUESTS_PER_MINUTE=100

# File Upload
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads

# Google Maps
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Monitoring
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Email Templates
EMAIL_FROM_NAME=BYD Horizon Club
EMAIL_FROM_ADDRESS=notifications@bydhorizon.com